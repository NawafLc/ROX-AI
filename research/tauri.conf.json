{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ROX Research",
  "version": "2.0.0",
  "identifier": "dev.roxai.research",
  "build": {
    "frontendDist": "../research-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ROX Research",
        "width": 1240,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#0B0D14",
        "decorations": false,
        "shadow": true,
        "theme": "Dark",
        "transparent": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**/ROX-Research Data/**", "**/ROX Research Vault/**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
