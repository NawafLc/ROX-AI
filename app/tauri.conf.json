{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ROX-AI",
  "version": "2.0.0",
  "identifier": "dev.roxai.app",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ROX-AI",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 660,
        "center": true,
        "backgroundColor": "#0B0D14",
        "decorations": false,
        "shadow": true,
        "theme": "Dark",
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}